---
/**
 * Foto con placeholder. Mientras no haya foto real muestra un bloque con gradiente
 * y una etiqueta "TODO: foto" para saber qué va ahí.
 * Para usar una foto real: guardala en src/assets/img/ (jpg, png o webp, cuanto más grande mejor)
 * y pasá src="nombre-del-archivo.jpg". Astro la convierte sola a AVIF/WebP en varios tamaños.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: string;
  alt: string;
  etiqueta?: string; // qué foto va acá (solo se ve en el placeholder)
  ratio?: string; // ej. '4/5', '16/9', '1/1'
  tono?: 'oro' | 'ambar' | 'brasa' | 'carbon';
  class?: string;
  eager?: boolean;
}
const { src, alt, etiqueta, ratio = '4/5', tono = 'ambar', class: className = '', eager = false } = Astro.props;

const imagenes = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const imagen = src ? imagenes[`/src/assets/img/${src}`]?.default : undefined;
if (src && !imagen) console.warn(`[Foto] No encontré src/assets/img/${src}`);

const gradientes = {
  oro: 'radial-gradient(120% 90% at 20% 10%, #deb07a44, transparent 60%), linear-gradient(160deg, #45321f, #17100b)',
  ambar: 'radial-gradient(110% 80% at 80% 0%, #a8733f66, transparent 60%), linear-gradient(200deg, #2e2017, #0f0a07)',
  brasa: 'radial-gradient(100% 80% at 10% 100%, #eb8a5f33, transparent 60%), linear-gradient(170deg, #2e2017, #17100b)',
  carbon: 'radial-gradient(90% 70% at 50% 30%, #6b4a3166, transparent 70%), #17100b',
};
---
<div class:list={['relative overflow-hidden rounded-[1.75rem] bg-espresso-800', className]} style={`aspect-ratio:${ratio}`}>
  {imagen ? (
    <Picture src={imagen} alt={alt} formats={['avif', 'webp']} widths={[400, 800, 1200]}
      sizes="(min-width: 1024px) 50vw, 100vw" loading={eager ? 'eager' : 'lazy'} decoding="async"
      class="absolute inset-0 size-full object-cover" pictureAttributes={{ class: 'contents' }} />
  ) : (
    <div class="absolute inset-0 grid place-items-center p-4 text-center" style={`background:${gradientes[tono]}`}
      role="img" aria-label={alt}>
      <span class="rounded-full border border-dashed border-crema-50/20 px-3 py-1 text-xs font-semibold tracking-wide text-crema-500">
        TODO: foto · {etiqueta ?? alt}
      </span>
    </div>
  )}
</div>
