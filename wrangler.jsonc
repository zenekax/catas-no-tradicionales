{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catasnotradicionales",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
