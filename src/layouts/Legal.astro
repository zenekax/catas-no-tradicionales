---
import Base from './Base.astro';
interface Props { titulo: string; descripcion: string; actualizado: string }
const { titulo, descripcion, actualizado } = Astro.props;
---
<Base titulo={`${titulo} · Catas No Tradicionales`} descripcion={descripcion}>
  <article class="contenedor max-w-3xl pt-32 pb-24">
    <p class="rounded-2xl border border-brasa-400/40 bg-brasa-400/10 p-4 text-sm text-brasa-400">
      BORRADOR para revisión. No es asesoramiento legal: revisalo con un profesional antes de publicarlo como definitivo.
    </p>
    <h1 class="mt-10 text-6xl sm:text-7xl">{titulo}</h1>
    <p class="mt-4 text-sm text-crema-500">Última actualización: {actualizado}</p>
    <div class="legal mt-10">
      <slot />
    </div>
  </article>
</Base>
