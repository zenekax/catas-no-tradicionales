---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada · Catas No Tradicionales" descripcion="Esta página no existe." noindex>
  <section class="contenedor grid min-h-[80dvh] content-center justify-items-start gap-6 pt-32 pb-16">
    <p class="rotulo">Error 404</p>
    <h1 class="text-6xl sm:text-8xl">Esta muestra <em>no está en la mesa.</em></h1>
    <p class="max-w-md text-crema-300">La página que buscás no existe o se movió. Volvé al inicio y seguí probando.</p>
    <a href="/" class="btn btn-primario">Volver al inicio</a>
  </section>
</Base>
