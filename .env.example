# Copiá este archivo como .env para desarrollo local.
# En producción, cargá estas variables en Cloudflare: Worker → Settings → Builds → Variables and secrets.

# ID del Meta Pixel. Si queda vacío, el Pixel NO se carga. (TODO: pasame el ID)
PUBLIC_META_PIXEL_ID=

# ID de la planilla de Google Sheets con las fechas (lo que va entre /d/ y /edit en la URL).
# La planilla tiene que estar compartida como "Cualquier persona con el enlace: lector".
# Si queda vacío, se usan las fechas de src/data/events.json.
GOOGLE_SHEET_ID=

# URL de la aplicación web de Google Apps Script que recibe las consultas del formulario de /empresas.
# (Apps Script → Implementar → Nueva implementación → Aplicación web). Si queda vacío, el formulario
# no envía nada y ofrece mandar la consulta por WhatsApp.
PUBLIC_FORM_URL=
