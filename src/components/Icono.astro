---
// Íconos inline (sin librerías). Uso: <Icono nombre="whatsapp" class="size-5" />
interface Props {
  nombre: 'whatsapp' | 'instagram' | 'calendario' | 'reloj' | 'pin' | 'flecha' | 'venda' | 'estrella';
  class?: string;
}
const { nombre, class: className = 'size-5' } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false"
  fill={nombre === 'whatsapp' || nombre === 'estrella' ? 'currentColor' : 'none'}
  stroke={nombre === 'whatsapp' || nombre === 'estrella' ? 'none' : 'currentColor'}
  stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {nombre === 'whatsapp' && (
    <path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.98L2 22l5.16-1.5A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3.06.89.9-2.98-.2-.31a8.2 8.2 0 1 1 6.86 3.73Zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.55.12-.16.25-.63.8-.78.97-.14.16-.29.18-.53.06a6.7 6.7 0 0 1-3.34-2.92c-.25-.43.25-.4.72-1.34.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47a.9.9 0 0 0-.65.3 2.73 2.73 0 0 0-.85 2.03c0 1.2.87 2.36.99 2.52.12.16 1.71 2.61 4.15 3.66 1.54.67 2.14.72 2.91.61.47-.07 1.46-.6 1.66-1.17.2-.58.2-1.07.14-1.17-.06-.1-.22-.16-.47-.28Z" />
  )}
  {nombre === 'instagram' && (<>
    <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".6" fill="currentColor" />
  </>)}
  {nombre === 'calendario' && (<>
    <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" />
  </>)}
  {nombre === 'reloj' && (<><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>)}
  {nombre === 'pin' && (<><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></>)}
  {nombre === 'flecha' && (<path d="M5 12h14M13 6l6 6-6 6" />)}
  {nombre === 'venda' && (<><path d="M2 10c4-2 16-2 20 0v4c-4 2-16 2-20 0Z" /><path d="M7 11.5h3M14 11.5h3" /></>)}
  {nombre === 'estrella' && (<path d="m12 2.5 2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9Z" />)}
</svg>
